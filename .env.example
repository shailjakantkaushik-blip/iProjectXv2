# Public (Vite client)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_TURNSTILE_SITE_KEY=

# Server-only (never prefix with VITE_ / NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
TURNSTILE_SECRET_KEY=
BILLING_CRON_SECRET=generate-a-long-random-string
# Optional override for alerts-digest cron (falls back to BILLING_CRON_SECRET)
# ALERTS_CRON_SECRET=generate-a-long-random-string

# BYOD (customer-hosted Supabase per organisation). Encrypts service-role
# secrets at rest in org_byod_connections. Generate a long random string (≥32).
# BYOD_SECRETS_KEK=replace-with-a-long-random-secret-at-least-32-chars

# Optional email providers (invoice delivery + PMO alert digests)
RESEND_API_KEY=
SENDGRID_API_KEY=
INVOICE_FROM_EMAIL=
# Optional alias for digest/from display (defaults to INVOICE_FROM_*)
# ALERTS_FROM_EMAIL=
# ALERTS_FROM_NAME=iProjectX Alerts
# Public app origin used in digest email links
# APP_BASE_URL=https://your-app.example.com

# Optional approved In-house AI model (OpenAI-compatible chat completions).
# Server-only — never prefix with VITE_. Works with Azure OpenAI, Ollama, vLLM,
# or a private gateway. Even when set, each organisation stays on the local
# engine until a platform_admin enables it (Platform → In-house AI model).
# INHOUSE_AI_ENABLED=true
# INHOUSE_AI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# INHOUSE_AI_API_VERSION=2024-06-01
# INHOUSE_AI_MODEL=your-deployment-or-model-name
# INHOUSE_AI_API_KEY=
# INHOUSE_AI_LABEL=Approved in-house model
# INHOUSE_AI_MAX_TOKENS=800
# INHOUSE_AI_TIMEOUT_MS=25000

# Legacy aliases supported by scripts/env-bridge.mjs
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
